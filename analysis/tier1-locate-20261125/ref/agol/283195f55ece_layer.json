{"_http": 200, "_url": "https://services2.arcgis.com/dCsYFJc4LmrWU6hM/arcgis/rest/services/Denver_SNAP_LILA/FeatureServer/0?f=json", "currentVersion": 12, "id": 0, "name": "Food Retail Locations", "type": "Feature Layer", "serviceItemId": "4f967b091b3a43b6a458840d6b03f0f9", "cacheMaxAge": 30, "displayField": "NAME", "description": "Dataset maintained by the Denver Department of Public Health and Environment (DDPHE), Community &amp; Behavioral Health (CBH) Food Systems Team. Data steward: Paola Babb.This dataset represents food retail locations across Denver and includes information on participation in federal and state nutrition assistance programs such as the Supplemental Nutrition Assistance Program (SNAP), Double Up Food Bucks (DUFB) and the Women Infant and Children Supplement Nutrition program (WIC). It is used to assess healthy food retail access and inform planning, policy, and investment strategies.Data sources include:DDPHE Public Health Investigations Team: Active food retail license data. State SNAP and WIC authorized retailer lists. Nourish Colorado: Double Up Food Bucks (DUFB) participating retailers. Processing steps include extracting active licensed food retail locations, standardizing and cleaning datasets, and combining the data with SNAP/WIC/DUFB retailer participation data, classifying retailers by type, and validating records where possible.Retail locations are classified into four categories:Category 4: Large Supermarkets and Other Grocery (&gt;15,000 sq ft) - Includes warehouse clubs and supercenters (e.g., King Soopers, Safeway, Walmart, Costco, Sprouts, Whole Foods). Category 3: Small Supermarkets and Other Grocery (&lt;15,000 sq ft) - Includes smaller grocery stores and large specialty stores (e.g., Trader Joe’s, Natural Grocers, Lowe’s Mercado, Leevers Locavore). Category 2: Specialty Food Stores - Includes meat markets, produce markets, seafood markets, and cultural/ethnic markets (e.g., carnicerías, neighborhood markets, butchers). Category 1: Convenience Stores - Includes corner stores, gas station markets, and pharmacies that sell food (e.g., CVS, Walgreens, 7-Eleven). Terms of Use: This dataset is intended for planning, analysis, and informational purposes. DDPHE is not liable for decisions made based on this dataset.", "copyrightText": "Denver Department of Public Health and Environment (DDPHE), Community & Behavioral Health (CBH) Food Systems Team", "defaultVisibility": true, "editingInfo": {"lastEditDate": 1784663386654, "schemaLastEditDate": 1784663386654, "dataLastEditDate": 1784663386654}, "relationships": [], "isDataVersioned": false, "hasContingentValuesDefinition": false, "supportsAppend": true, "supportsCalculate": true, "supportsASyncCalculate": true, "supportsTruncate": true, "supportsAttachmentsByUploadId": true, "supportsAttachmentsResizing": true, "supportsRollbackOnFailureParameter": true, "supportsStatistics": true, "supportsExceedsLimitStatistics": true, "supportsAdvancedQueries": true, "supportsValidateSql": true, "supportsCoordinatesQuantization": true, "supportsLayerOverrides": true, "supportsTilesAndBasicQueriesMode": true, "supportsFieldDescriptionProperty": true, "supportsQuantizationEditMode": true, "supportsColumnStoreIndex": true, "supportsApplyEditsWithGlobalIds": false, "supportsReturningQueryGeometry": true, "enableNullGeometry": false, "advancedQueryCapabilities": {"supportsPagination": true, "supportsPaginationOnAggregatedQueries": true, "supportsQueryRelatedPagination": true, "supportsQueryWithDistance": true, "supportsOutDistance": true, "supportsReturningQueryExtent": true, "supportsStatistics": true, "supportsOrderBy": true, "supportsDistinct": true, "supportsQueryWithResultType": true, "supportsSqlExpression": true, "supportsTimeRelation": true, "supportsAdvancedQueryRelated": true, "supportsCountDistinct": true, "supportsPercentileStatistics": true, "supportsApproxPercentileStatistics": true, "supportsSpatialAggregationStatistics": true, "supportedSpatialAgg