{"_http": 200, "_url": "https://www.arcgis.com/sharing/rest/content/items/42c6e87ecdbe4cfaa676fcdb2ddceecb?f=json", "id": "42c6e87ecdbe4cfaa676fcdb2ddceecb", "owner": "b.sanaiemovahed_NU", "ownerId": "639471c5c40a33c7d661cba2d623a318", "orgId": "KUeKSLlMUcWvuPRM", "created": 1743607046000, "modified": 1743616765000, "guid": null, "name": "All_TH_Lots", "title": "Twonhouse Lots", "type": "Feature Service", "typeKeywords": ["ArcGIS API for JavaScript", "ArcGIS Server", "Data", "Feature Access", "Feature Service", "Metadata", "Service", "Singlelayer", "Hosted Service"], "description": "This layer was created using two parcel datasets provided by the City of Boston, which include detailed property boundaries, land use classifications, zoning information, and assessor attributes. These datasets were combined and filtered to identify parcels containing townhouses within the study area of the Boston Townhouse Pattern Analysis project. The rich attribute information supports in-depth analysis of development patterns, zoning compliance, and building characteristics.<div><br /><br /><table border='0' cellpadding='0' cellspacing='0' style='border-collapse:collapse; width:335pt;' width='445'><tbody><tr height='26' style='height:19.5pt;'><td height='26' style='height:19.5pt; width:101pt;' width='134'><b>Field Name</b></td><td style='width:234pt;' width='311'><b>Meaning / Description</b></td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>map_par_id</td><td style='width:234pt;' width='311'>Unique parcel ID used by the city for mapping and tracking parcels.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>map_par_2</td><td style='width:234pt;' width='311'>Secondary parcel identifier, sometimes used for internal references.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>loc_id</td><td style='width:234pt;' width='311'>Location ID associated with the physical property address.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>st_num_1</td><td style='width:234pt;' width='311'>Street number of the parcel address.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>st_name_1</td><td style='width:234pt;' width='311'>Street name of the parcel address.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>hood</td><td style='width:234pt;' width='311'>Neighborhood in which the parcel is located.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>yr_built_1</td><td style='width:234pt;' width='311'>Year the primary building was constructed.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>yr_remodel_1</td><td style='width:234pt;' width='311'>Year of the most recent remodel or significant renovation.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>landsf</td><td style='width:234pt;' width='311'>Total land square footage of the parcel.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>far_actual_1</td><td style='width:234pt;' width='311'>Floor Area Ratio (actual), calculated as total building floor area divided by land area.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>lotcov</td><td style='width:234pt;' width='311'>Lot coverage percentage—portion of parcel area covered by structures.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>units</td><td style='width:234pt;' width='311'>Number of residential or commercial units on the parcel.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>zone</td><td style='width:234pt;' width='311'>Zoning code that applies to the parcel.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>outbldgs</td><td style='width:234pt;' width='311'>Indicator or count of additional structures (e.g., garages, sheds).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>multiacc</td><td style='width:234pt;' width='311'>Indicator of multi-access or multiple entrances.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>extragfa</td><td style='width:234pt;' width='311'>Extra Gross Floor Area beyond the main building, e.g., extensions.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>backyd</td><td style='width:234pt;' width='311'>Indicator if the parcel has a backyard.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>far_nc</td><td style='width:234pt;' width='311'>Floor Area Ratio for new construction.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>unit_nc</td><td style='width:234pt;' width='311'>Number of units proposed or allowed for new construction.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>ls_nc</td><td style='width:234pt;' width='311'>Lot size allowed for new construction.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>nc_count</td><td style='width:234pt;' width='311'>Count of new construction buildings or units.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>frontage_l</td><td style='width:234pt;' width='311'>Linear frontage of the parcel (usually along the street).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>width</td><td style='width:234pt;' width='311'>Width of the parcel (front dimension).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>depth</td><td style='width:234pt;' width='311'>Depth of the parcel (back dimension).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>nf_extlen</td><td style='width:234pt;' width='311'>Length of extension or non-frontage external dimension.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>luc</td><td style='width:234pt;' width='311'>Land use code—numeric code representing the type of land use.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>lu_desc</td><td style='width:234pt;' width='311'>Land use description corresponding to luc.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>bldg_type</td><td style='width:234pt;' width='311'>Building type classification (e.g., townhouse, single-family, commercial).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>own_occ</td><td style='width:234pt;' width='311'>Owner occupancy status (owner-occupied or not).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>type_cat</td><td style='width:234pt;' width='311'>Categorical type of property (e.g., residential, commercial).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>lot_class</td><td style='width:234pt;' width='311'>Classification of the lot (e.g., regular, corner, irregular).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>dim_class</td><td style='width:234pt;' width='311'>Dimensional class of the lot, based on size or zoning standards.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>front_setback</td><td style='width:234pt;' width='311'>Required or actual front setback (distance from street to building).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>rear_setback</td><td style='width:234pt;' width='311'>Required or actual rear setback (distance from building to rear boundary).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>side_setback</td><td style='width:234pt;' width='311'>Required or actual side setback (distance from building to side boundary).</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>side_setback_min</td><td style='width:234pt;' width='311'>Minimum allowed side setback.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>side_setback_max</td><td style='width:234pt;' width='311'>Maximum allowed side setback.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>front_sb_rule</td><td style='width:234pt;' width='311'>Front setback zoning rule applied to this parcel.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>rear_sb_rule</td><td style='width:234pt;' width='311'>Rear setback zoning rule applied.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>side_sb_rule</td><td style='width:234pt;' width='311'>Side setback zoning rule applied.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>front_sb_nc</td><td style='width:234pt;' width='311'>Front setback for new construction.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>rear_sb_nc</td><td style='width:234pt;' width='311'>Rear setback for new construction.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>side_sb_nc</td><td style='width:234pt;' width='311'>Side setback for new construction.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>building_height</td><td style='width:234pt;' width='311'>Height of the primary building.</td></tr><tr height='32' style='height:24pt;'><td height='32' style='height:24pt; width:101pt;' width='134'>owner</td><td style='width:234pt;' width='311'>Name of the property owner or owning entity.</td></tr></tbody></table></div>", "tags": ["boston", "parcels", "townhouse"], "snippet": "This layer represents parcels containing townhouses within the study area of the Boston Townhouse Pattern Analysis project. The parcel data, provided by the City of Boston, includes property boundaries and assessor information used to identify and examine townhouse development patterns.", "thumbnail": "thumbnail/thumbnail1743616636476.png", "documentation": null, "extent": [[744542.2874198854, 2912359.188662559], [780513.5855558813, 2943300.246202886]], "categories": [], "spatialReference": "NAD_1983_StatePlane_Massachusetts_Mainland_FIPS_2001_Feet", "accessInformation": "", "classification": null, "licenseInfo": "", "culture": "en-us", "properties": null, "advancedSettings": null, "url": "https://services1.arcgis.com/KUeKSLlMUcWvuPRM/arcgis/rest/services/All_TH_Lots/FeatureServer", "proxyFilter": null, "access": "public", "size": 876544, "subInfo": 0, "appCategories": [], "industries": [], "languages": [], "largeThumbnail": null, "banner": null, "screenshots": [], "listed": false, "commentsEnabled": true, "numComments": 0, "numRatings": 0, "avgR