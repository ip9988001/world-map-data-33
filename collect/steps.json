{
 "schema": "v2.1",
 "_comment": "自研模式 v2.1 的唯一参数来源。11 个工人入口读它，11 个工头读它，STEP-0X.md 与它交叉校验。改参数只改这里。",
 "engine": {
  "channels": [
   "keyset",
   "ids",
   "offset"
  ],
  "default_unit_rows": 500000,
  "default_workers": 4,
  "geom_allow": [
   "point",
   "multipoint",
   "socrata",
   "na"
  ]
 },
 "steps": {
  "00": {
   "kind": "bootstrap",
   "title": "地基",
   "desc": "引擎 + 工头 + 账本 + 自检 + 单测立起来",
   "evidence": [
    "selftest",
    "unit_tests",
    "state"
   ],
   "cmds": [
    "--entry-check"
   ],
   "supervise": {
    "stall_min": 120,
    "doc": "collect/steps/STEP-00.md",
    "wf": "worker-00.yml",
    "wake_reason": "地基：工人已停手，等大脑判验收",
    "cmds": [
     "--entry-check"
    ]
   }
  },
  "01": {
   "kind": "preflight",
   "title": "预检",
   "desc": "给全量图层体检，产出 layer_plan.csv（每层该怎么搬）",
   "shards": 12,
   "select": {
    "source": "survey"
   },
   "evidence": [
    "layer_plan.csv",
    "count_rate"
   ],
   "accept": {
    "plan_rows_min": 50000,
    "plan_empty_max": 0,
    "count_rate_min": 0.78
   },
   "supervise": {
    "stall_min": 180,
    "doc": "collect/steps/STEP-01.md",
    "wf": "worker-01.yml",
    "wake_reason": "预检：分片已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 02",
     "--kick 01 --workers 12"
    ]
   }
  },
  "02": {
   "kind": "collect",
   "title": "试点 8 层",
   "desc": "8 种典型层各采一遍，验证三条通道与断点续传",
   "select": {
    "source": "pilot_layers"
   },
   "workers": 4,
   "unit_rows": 500000,
   "tag": "collect-step02-{layer}",
   "report": "pilot",
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "short_units"
   ],
   "accept": {
    "with_rows_min": 8,
    "diff_max": 0.01
   },
   "supervise": {
    "stall_min": 240,
    "doc": "collect/steps/STEP-02.md",
    "wf": "worker-02.yml",
    "wake_reason": "试点 8 层：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 03",
     "--kick 02 --layers <layer> --workers 4"
    ]
   }
  },
  "03": {
   "kind": "collect",
   "title": "单州试跑 KS",
   "desc": "一个州的所有地址点层跑一遍，验证批量/并发/打包/续传在真实规模下不崩",
   "select": {
    "state": "KS"
   },
   "workers": 4,
   "unit_rows": 200000,
   "tag": "collect-step03-{layer}",
   "gate": {
    "gray_layers": 20,
    "limit_mode": "spread"
   },
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "unit_errors",
    "short_units"
   ],
   "accept": {
    "done_rate_min": 0.85,
    "failed_rate_max": 0.15
   },
   "supervise": {
    "stall_min": 240,
    "doc": "collect/steps/STEP-03.md",
    "wf": "worker-03.yml",
    "wake_reason": "单州试跑 KS：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 04",
     "--kick 03 --workers 4 --max-layers 20"
    ]
   }
  },
  "04": {
   "kind": "collect",
   "title": "全州放量",
   "desc": "覆盖整州的大层全部搬回，一次拿到大部分人口",
   "select": {
    "where": "row_count>300000",
    "state_exclude": [
     "未定位",
     ""
    ],
    "title_include": "address|addr\\b|situs|e-?911|ng911|mailing|delivery point|location point",
    "title_exclude": "fire|nfirs|response|parcel|zone|district|boundary|hydrant|business|poi|of interest|europe|canada|mexico|bus stop|shelter|parking|traffic|crash|collision|permit|school|hospital|station|cell ?tower|antenna|solar|weather|flood|watershed|trail|park\\b|bridge|billboard|licen|inspection|vacant|demolition",
    "rows_max": 5000000,
    "skip_blocked": true,
    "skip_done": true
   },
   "workers": 4,
   "unit_rows": 1000000,
   "tag": "collect-step04-{layer}",
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "unit_errors"
   ],
   "accept": {
    "total_rows_min": 30000000,
    "layers_min": 40,
    "layers_max": 60,
    "per_layer_rows_max": 5000000
   },
   "supervise": {
    "stall_min": 300,
    "doc": "collect/steps/STEP-04.md",
    "wf": "worker-04.yml",
    "wake_reason": "全州放量：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 05",
     "--kick 04 --workers 4 --max-layers 10",
     "--kick 04 --workers 4"
    ]
   },
   "batch": 60
  },
  "05": {
   "kind": "collect",
   "title": "县市碎片",
   "desc": "剩余两万层分批扫完，不留 pending",
   "select": {
    "mode": "bulk",
    "batch": 100,
    "order": "rows_asc",
    "rows_min": 5000,
    "skip_blocked": true,
    "title_include": "address|addr\\b|situs|e-?911|ng911|mailing|delivery point|location point",
    "title_exclude": "fire|nfirs|response|parcel|zone|district|boundary|hydrant|business|poi|of interest|europe|canada|mexico|bus stop|shelter|parking|traffic|crash|collision|permit|school|hospital|station|cell ?tower|antenna|solar|weather|flood|watershed|trail|park\\b|bridge|billboard|licen|inspection|vacant|demolition",
    "rows_max": 500000,
    "state_exclude": [
     "未定位",
     ""
    ],
    "skip_done": true
   },
   "workers": 4,
   "unit_rows": 100000,
   "tag": "collect-step05-{layer}",
   "roll": {
    "mode": "batches",
    "max_per_authorization": 5
   },
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "blocked"
   ],
   "accept": {
    "failed_rate_max": 0.15,
    "layers_min": 80,
    "layers_max": 100
   },
   "supervise": {
    "stall_min": 300,
    "doc": "collect/steps/STEP-05.md",
    "wf": "worker-05.yml",
    "wake_reason": "县市碎片：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 06",
     "--kick 05 --workers 4 --offset 0 --size 100"
    ]
   }
  },
  "06": {
   "kind": "report",
   "title": "收工",
   "desc": "汇总覆盖率总表（只出报告，不推企微 —— 企微由大脑发）",
   "source": "checkpoints",
   "evidence": [
    "FINAL_REPORT.md"
   ],
   "cmds": [
    "--review pass"
   ],
   "supervise": {
    "stall_min": 120,
    "doc": "collect/steps/STEP-06.md",
    "wf": "worker-06.yml",
    "wake_reason": "收工：报告已出，等大脑判验收",
    "cmds": [
     "--review pass --note \"收工\""
    ]
   }
  },
  "07": {
   "kind": "collect",
   "title": "碎片补齐",
   "desc": "补上 05 因行数门槛排掉的小层（<5000 行）与软词地址层 —— 完整性，不是扩口径",
   "select": {
    "mode": "bulk",
    "batch": 120,
    "order": "rows_asc",
    "rows_min": 1,
    "rows_max": 4999,
    "skip_blocked": true,
    "state_exclude": [
     "未定位",
     ""
    ],
    "title_include": "address|addr\\b|situs|e-?911|ng911|mailing|delivery point|location point",
    "skip_done": true
   },
   "workers": 4,
   "unit_rows": 100000,
   "tag": "collect-step07-{layer}",
   "evidence": [
    "report",
    "releases",
    "checkpoint"
   ],
   "accept": {
    "failed_rate_max": 0.2,
    "layers_min": 250,
    "layers_max": 1500
   },
   "supervise": {
    "stall_min": 300,
    "doc": "collect/steps/STEP-07.md",
    "wf": "worker-07.yml",
    "wake_reason": "碎片补齐：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 08",
     "--kick 07 --workers 4 --offset 0 --size 120"
    ]
   }
  },
  "08": {
   "kind": "analyze",
   "title": "去重与真实地址数",
   "desc": "全量流式读 Release 里的 parts，按 addr_key 精确去重，算独立地址数与重复来源",
   "source": "releases",
   "tag_prefixes": [
    "collect-step03-",
    "collect-step04-",
    "collect-step05-",
    "collect-step07-"
   ],
   "evidence": [
    "FINAL_REPORT.md"
   ],
   "accept": {
    "states_min": 40,
    "unique_rows_min": 30000000,
    "dup_rate_max": 0.9
   },
   "supervise": {
    "stall_min": 120,
    "doc": "collect/steps/STEP-08.md",
    "wf": "worker-08.yml",
    "wake_reason": "去重报告：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 09",
     "--kick 08"
    ]
   }
  },
  "09": {
   "kind": "delta",
   "title": "增量同步",
   "desc": "探测编辑时间字段，只对探到的层拉变更；独立 delta tag，绝不覆盖全量",
   "select": {
    "source": "collected",
    "batch": 1200
   },
   "since_days": 90,
   "tag": "collect-delta-{layer}-{date}",
   "evidence": [
    "report",
    "releases"
   ],
   "accept": {
    "field_rate_min": 0.1,
    "failed_rate_max": 0.2
   },
   "supervise": {
    "stall_min": 180,
    "doc": "collect/steps/STEP-09.md",
    "wf": "worker-09.yml",
    "wake_reason": "增量同步：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --note \"项目收尾\"",
     "--kick 09"
    ]
   }
  },
  "10": {
   "kind": "parcel_situs",
   "title": "宗地地址扩采",
   "desc": "从 Polygon/Polyline 层里挑出真正带房产地址字段的层；按实测有效率只采高产出层，不按声明行数全采",
   "select": {
    "source": "layer_plan",
    "file": "collect/batch1.csv",
    "grade": [
     "strong",
     "weak"
    ],
    "eff_min": 0.2,
    "mode": "bulk",
    "order": "rows_desc",
    "offset": 0,
    "batch": 200,
    "skip_done": true
   },
   "workers": 4,
   "unit_rows": 100000,
   "tag": "collect-step10-{layer}",
   "geom_in": [],
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "layer_plan.csv",
    "state"
   ],
   "accept": {
    "eff_min": 0.2,
    "pick_layers_min": 1000,
    "budget_min_max": 900
   },
   "supervise": {
    "stall_min": 180,
    "doc": "collect/steps/STEP-10.md",
    "wf": "worker-10.yml",
    "wake_reason": "宗地扩采：工人已停手，等大脑判验收",
    "cmds": [
     "--kick 10 --offset 0 --size 200",
     "--review pass --note \"宗地扩采批1收尾\""
    ]
   }
  },
  "10b": {
   "kind": "parcel_situs",
   "title": "宗地地址扩采 batch2+",
   "desc": "batch1 之外的强/弱有效层全部采（reject 只记账不采）",
   "select": {
    "source": "layer_plan",
    "file": "collect/situs_layers.csv",
    "grade": [
     "strong",
     "weak"
    ],
    "mode": "bulk",
    "order": "rows_desc",
    "offset": 0,
    "batch": 4000,
    "skip_done": true
   },
   "workers": 4,
   "unit_rows": 100000,
   "tag": "collect-step10b-{layer}",
   "geom_in": [],
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "layer_plan.csv",
    "state"
   ],
   "accept": {
    "eff_min": 0.2,
    "pick_layers_min": 1000,
    "budget_min_max": 900
   },
   "supervise": {
    "stall_min": 180,
    "doc": "collect/steps/STEP-10.md",
    "wf": "worker-10.yml",
    "wake_reason": "宗地扩采：工人已停手，等大脑判验收",
    "cmds": [
     "--kick 10 --offset 0 --size 200",
     "--review pass --note \"宗地扩采批1收尾\""
    ]
   },
   "done_from": "10"
  },
  "04b": {
   "kind": "collect",
   "title": "全州放量（全量补采）",
   "desc": "点类地址层 row_count>300000 全量补采；已采层靠 skip_done 剔除",
   "select": {
    "where": "row_count>300000",
    "title_include": "address|addr\\b|situs|e-?911|ng911|mailing|delivery point|location point",
    "skip_done": true
   },
   "workers": 4,
   "unit_rows": 1000000,
   "tag": "collect-step04-{layer}",
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "unit_errors"
   ],
   "accept": {
    "total_rows_min": 30000000,
    "layers_min": 40,
    "layers_max": 60,
    "per_layer_rows_max": 5000000
   },
   "supervise": {
    "stall_min": 300,
    "doc": "collect/steps/STEP-04.md",
    "wf": "worker-04.yml",
    "wake_reason": "全州放量：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 05",
     "--kick 04 --workers 4 --max-layers 10",
     "--kick 04 --workers 4"
    ]
   },
   "batch": 60,
   "done_from": "04"
  },
  "05b": {
   "kind": "collect",
   "title": "县市碎片（全量补采）",
   "desc": "剩余两万层分批扫完，不留 pending",
   "select": {
    "mode": "bulk",
    "batch": 4000,
    "order": "rows_asc",
    "rows_min": 5000,
    "title_include": "address|addr\\b|situs|e-?911|ng911|mailing|delivery point|location point",
    "rows_max": 300000,
    "skip_done": true,
    "offset": 0
   },
   "workers": 4,
   "unit_rows": 100000,
   "tag": "collect-step05-{layer}",
   "roll": {
    "mode": "batches",
    "max_per_authorization": 5
   },
   "evidence": [
    "report",
    "releases",
    "checkpoint",
    "blocked"
   ],
   "accept": {
    "failed_rate_max": 0.15,
    "layers_min": 80,
    "layers_max": 100
   },
   "supervise": {
    "stall_min": 300,
    "doc": "collect/steps/STEP-05.md",
    "wf": "worker-05.yml",
    "wake_reason": "县市碎片：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 06",
     "--kick 05 --workers 4 --offset 0 --size 100"
    ]
   },
   "done_from": "05"
  },
  "07b": {
   "kind": "collect",
   "title": "碎片补齐（全量补采）",
   "desc": "补上 05 因行数门槛排掉的小层（<5000 行）与软词地址层 —— 完整性，不是扩口径",
   "select": {
    "mode": "bulk",
    "batch": 4000,
    "order": "rows_asc",
    "rows_min": 1,
    "rows_max": 4999,
    "title_include": "address|addr\\b|situs|e-?911|ng911|mailing|delivery point|location point",
    "skip_done": true,
    "offset": 0
   },
   "workers": 4,
   "unit_rows": 100000,
   "tag": "collect-step07-{layer}",
   "evidence": [
    "report",
    "releases",
    "checkpoint"
   ],
   "accept": {
    "failed_rate_max": 0.2,
    "layers_min": 250,
    "layers_max": 1500
   },
   "supervise": {
    "stall_min": 300,
    "doc": "collect/steps/STEP-07.md",
    "wf": "worker-07.yml",
    "wake_reason": "碎片补齐：工人已停手，等大脑判验收",
    "cmds": [
     "--review pass --next 08",
     "--kick 07 --workers 4 --offset 0 --size 120"
    ]
   },
   "done_from": "07"
  }
 }
